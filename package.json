{
  "name": "typing-duel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:migrate": "node --experimental-strip-types server/db/migrate.ts up",
    "db:migrate:down": "node --experimental-strip-types server/db/migrate.ts down",
    "db:migrate:status": "node --experimental-strip-types server/db/migrate.ts status",
    "db:seed": "node --experimental-strip-types server/db/seed.ts",
    "server": "node --experimental-strip-types server/index.ts",
    "test": "node --experimental-strip-types --test server/**/*.test.ts shared/**/*.test.ts src/**/*.test.ts"
  },
  "dependencies": {
    "@nimiq/mini-app-sdk": "^0.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
