AGENTS_FOLDER=.agents

# House wallet — TESTNET ONLY. Never put a mainnet key here (see CLAUDE.md).
# Generate your own with:
#   node -e "import('@nimiq/core').then(N => console.log(N.PrivateKey.generate().toHex()))"
ESCROW_PRIVATE_KEY=

# A Nimiq testnet node's JSON-RPC endpoint. Signing happens locally (the
# private key above never leaves this process) — this is only used to
# check balances, broadcast signed transactions, and look transactions up.
# Required instead of just connecting a light client directly because
# @nimiq/core's v2 P2P client doesn't work under Node.js — see README.md's
# "House wallet setup" section for why, and how to get one:
#   - request devnet RPC access from Nimiq's team, or
#   - run your own testnet node with RPC enabled
NIMIQ_RPC_URL=
NIMIQ_RPC_USERNAME=
NIMIQ_RPC_PASSWORD=
